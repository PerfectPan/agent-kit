{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",
  "rushVersion": "5.180.0",
  "pnpmVersion": "12.8.1",
  "nodeSupportedVersionRange": "^24.11.0",
  "ensureConsistentVersions": true,
  "projectFolderMinDepth": 1,
  "projectFolderMaxDepth": 2,
  "repository": {
    "url": "https://github.com/PerfectPan/agent-kit.git",
    "defaultBranch": "main"
  },
  "projects": [
    {
      "packageName": "@rivus/agent-kit",
      "projectFolder": "packages/agent-kit",
      "versionPolicyName": "main"
    },
    {
      "packageName": "@rivus/agent-kit-platform",
      "projectFolder": "packages/platform",
      "shouldPublish": false
    },
    {
      "packageName": "@rivus/agent-kit-catalog",
      "projectFolder": "packages/catalog",
      "shouldPublish": false
    },
    {
      "packageName": "@rivus/agent-kit-platform-node",
      "projectFolder": "packages/platform-node",
      "shouldPublish": false
    },
    {
      "packageName": "@rivus/agent-kit-sessions",
      "projectFolder": "packages/sessions",
      "shouldPublish": false
    },
    {
      "packageName": "@rivus/agent-kit-harness",
      "projectFolder": "packages/harness",
      "shouldPublish": false
    },
    {
      "packageName": "@rivus/agent-kit-testing",
      "projectFolder": "packages/testing",
      "shouldPublish": false
    },
    {
      "packageName": "architecture-boundaries",
      "projectFolder": "infra/architecture",
      "shouldPublish": false
    },
    {
      "packageName": "repo-scripts",
      "projectFolder": "scripts",
      "shouldPublish": false
    }
  ]
}
