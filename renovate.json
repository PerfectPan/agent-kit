{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "ignorePaths": ["**/node_modules/**"],
  "timezone": "Asia/Shanghai",
  "schedule": ["* 0-6 * * 1"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prBodyNotes": [
    "When a published package's runtime dependencies change, add a changeset as described in [Bot Pull Requests](https://github.com/PerfectPan/agent-kit/blob/main/docs/development/release.md#bot-pull-requests)."
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 1 * *"]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major"
    },
    {
      "matchPackageNames": ["size-limit", "@size-limit/**"],
      "groupName": "size-limit"
    },
    {
      "extends": ["packages:vitePlus"],
      "groupName": "vite-plus toolchain"
    },
    {
      "matchPackageNames": ["oxlint-plugin-eslint"],
      "groupName": "vite-plus toolchain"
    },
    {
      "matchPackageNames": ["effect", "@effect/vitest"],
      "groupName": "effect",
      "prBodyNotes": [
        "Updating the exact optional effect peer requires only one minor changeset naming both @rivus/agent-kit and @rivus/agent-kit-collab; its summary must name the new version and say that hosts pinning the old one fail to install under npm. Documentation refers to peerDependencies.effect and needs no version edits; follow [Bot Pull Requests](https://github.com/PerfectPan/agent-kit/blob/main/docs/development/release.md#bot-pull-requests)."
      ]
    },
    {
      "matchDepTypes": ["packageManager"],
      "groupName": "pnpm"
    },
    {
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-boundaries",
        "eslint-import-resolver-typescript",
        "oxlint-plugin-eslint",
        "oxc-parser"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchDepTypes": ["engines", "devEngines.runtime"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@perfectpan/lint-config"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump"
  }
}
