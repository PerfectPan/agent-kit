{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "ignorePaths": ["**/node_modules/**"],
  "timezone": "Asia/Shanghai",
  "schedule": ["* 0-6 * * 1"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 1 * *"],
    "prBodyNotes": [
      "The changeset automation does not cover lock-file-only updates. Check whether a bundled dependency (for example zod/mini) changed the built output and add a patch changeset if so; follow [Bot Pull Requests](https://github.com/PerfectPan/agent-kit/blob/main/docs/development/release.md#bot-pull-requests)."
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major"
    },
    {
      "matchPackageNames": ["size-limit", "@size-limit/**"],
      "groupName": "size-limit"
    },
    {
      "extends": ["packages:vitePlus"],
      "groupName": "vite-plus toolchain"
    },
    {
      "matchPackageNames": ["oxlint-plugin-eslint"],
      "groupName": "vite-plus toolchain"
    },
    {
      "matchPackageNames": ["effect", "@effect/vitest"],
      "groupName": "effect",
      "prBodyNotes": [
        "The changeset automation does not detect optional effect peer updates. Add one minor changeset naming both @rivus/agent-kit and @rivus/agent-kit-collab, explaining the new peer version and npm install failure for hosts pinning the old version. Keep the peer, catalog and documentation aligned; follow [Bot Pull Requests](https://github.com/PerfectPan/agent-kit/blob/main/docs/development/release.md#bot-pull-requests)."
      ]
    },
    {
      "matchDepTypes": ["packageManager"],
      "groupName": "pnpm"
    },
    {
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-boundaries",
        "eslint-import-resolver-typescript",
        "oxlint-plugin-eslint",
        "oxc-parser"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchDepTypes": ["engines", "devEngines.runtime"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@perfectpan/lint-config"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump"
  },
  "gitIgnoredAuthors": ["agent-kit-changeset-bot@users.noreply.invalid"]
}
