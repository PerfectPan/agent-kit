{
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "description": "Private bilingual website for agent-kit. It is not published.",
  "homepage": "https://perfectpan.github.io/agent-kit/",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter website-api run generate && vp build && node scripts/publish-search-index.mjs",
    "lint": "vp lint 2>&1",
    "typecheck": "tsr generate && tsc -p tsconfig.json",
    "test": "vp test --passWithNoTests",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "catalog:",
    "@fontsource/jetbrains-mono": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-toggle-group": "catalog:",
    "@rivus/agent-kit": "workspace:*",
    "@rivus/agent-kit-collab": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
