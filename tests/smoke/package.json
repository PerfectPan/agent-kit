{
  "name": "agent-kit-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Smoke tests against the coding agents installed on this machine. Run by hand with `smoke`; CI never runs them.",
  "type": "module",
  "scripts": {
    "build": "",
    "lint": "vp lint 2>&1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "",
    "smoke": "vp test --passWithNoTests",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.6.0",
    "@rivus/agent-kit-acp": "workspace:*",
    "@rivus/agent-kit-platform-node": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "@types/node": "24.19.2",
    "effect": "4.0.3",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  }
}
