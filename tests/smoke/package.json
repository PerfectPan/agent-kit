{
  "name": "agent-kit-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Smoke tests against the coding agents installed on this machine. Run by hand with `smoke`; CI never runs them.",
  "type": "module",
  "scripts": {
    "build": "",
    "lint": "vp lint 2>&1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "",
    "smoke": "vp test --passWithNoTests",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit-acp": "workspace:*",
    "@rivus/agent-kit-platform-node": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
