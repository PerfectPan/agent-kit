{
  "name": "agent-kit-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Smoke tests against the coding agents installed on this machine. Run by hand with `smoke`; CI never runs them.",
  "type": "module",
  "scripts": {
    "build": "",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "",
    "smoke": "vitest run --passWithNoTests",
    "format": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json .",
    "format:check": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json --check ."
  },
  "devDependencies": {
    "@effect/vitest": "4.0.1",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.4.0",
    "@rivus/agent-kit-acp": "workspace:*",
    "@rivus/agent-kit-platform-node": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "@types/node": "24.19.1",
    "effect": "4.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
