{
  "name": "@rivus/agent-kit-sessions",
  "version": "0.0.0",
  "private": true,
  "description": "Session discovery, transcripts and usage for each coding agent. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public.ts"
  },
  "scripts": {
    "build": "",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests 2>&1",
    "format": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json .",
    "format:check": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json --check ."
  },
  "dependencies": {
    "@rivus/agent-kit-catalog": "workspace:*",
    "@rivus/agent-kit-platform": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.4.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
