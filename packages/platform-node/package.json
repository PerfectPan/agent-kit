{
  "name": "@rivus/agent-kit-platform-node",
  "version": "0.0.0",
  "private": true,
  "description": "Node implementation of the Platform port. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./public": "./src/public.ts",
    "./public/effect": "./src/effect.ts"
  },
  "scripts": {
    "build": "",
    "lint": "vp lint 2>&1 && effect-tsgo diagnostics --project tsconfig.json --strict && effect-tsgo diagnostics --project test/tsconfig.json --strict",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vp test 2>&1",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@rivus/agent-kit-platform": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@perfectpan/lint-config": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
