{
  "extends": "@perfectpan/lint-config/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "lib": ["ES2024"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
