{
  "name": "@rivus/agent-kit-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Platform port types and the byte-stream line splitter. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./public": "./src/public.ts",
    "./public/effect": "./src/effect.ts"
  },
  "scripts": {
    "build": "",
    "lint": "vp lint 2>&1 && effect-tsgo diagnostics --project tsconfig.json --strict",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test 2>&1",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.6.0",
    "effect": "4.0.1",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "effect": "4.0.1"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
