{
  "name": "@rivus/agent-kit",
  "version": "0.19.1",
  "description": "Connect to third-party coding agents: identity, installed-agent detection, session logs, transcripts, driving agents over ACP and the host platform port.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectPan/agent-kit.git",
    "directory": "packages/agent-kit"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./acp": {
      "types": "./dist/acp.d.ts",
      "default": "./dist/acp.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./cost": {
      "types": "./dist/cost.d.ts",
      "default": "./dist/cost.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./harness/events": {
      "types": "./dist/harness/events.d.ts",
      "default": "./dist/harness/events.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./node/effect": {
      "types": "./dist/node/effect.d.ts",
      "default": "./dist/node/effect.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./platform/effect": {
      "types": "./dist/platform/effect.d.ts",
      "default": "./dist/platform/effect.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "default": "./dist/redact.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/effect": {
      "types": "./dist/testing/effect.d.ts",
      "default": "./dist/testing/effect.js"
    },
    "./transcript": {
      "types": "./dist/transcript.d.ts",
      "default": "./dist/transcript.js"
    },
    "./transcript/usage": {
      "types": "./dist/transcript/usage.d.ts",
      "default": "./dist/transcript/usage.js"
    },
    "./package.json": "./package.json",
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only && size-limit 2>&1 && node scripts/check-dist.ts && node scripts/smoke-consumer.ts",
    "lint": "vp lint 2>&1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@decimalturn/toml-patch": "catalog:",
    "es-toolkit": "catalog:",
    "jsonc-parser": "catalog:",
    "shell-quote": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit-acp": "workspace:*",
    "@rivus/agent-kit-catalog": "workspace:*",
    "@rivus/agent-kit-cost": "workspace:*",
    "@rivus/agent-kit-discovery": "workspace:*",
    "@rivus/agent-kit-harness": "workspace:*",
    "@rivus/agent-kit-platform": "workspace:*",
    "@rivus/agent-kit-platform-node": "workspace:*",
    "@rivus/agent-kit-redact": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "@rivus/agent-kit-testing": "workspace:*",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxc-parser": "catalog:",
    "publint": "catalog:",
    "rolldown": "1.2.13",
    "size-limit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
