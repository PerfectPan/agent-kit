{
  "name": "@rivus/agent-kit-acp",
  "version": "0.0.0",
  "private": true,
  "description": "Driving coding agents over the Agent Client Protocol: profiles, connections, sessions and bindings. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public.ts",
    "./spi": "./src/spi.ts"
  },
  "scripts": {
    "build": "",
    "lint": "vp lint 2>&1",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vp test 2>&1",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@rivus/agent-kit-catalog": "workspace:*",
    "@rivus/agent-kit-platform": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit-platform-node": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
