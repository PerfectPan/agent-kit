{
  "name": "@rivus/agent-kit-acp",
  "version": "0.0.0",
  "private": true,
  "description": "Driving coding agents over the Agent Client Protocol: profiles, connections, sessions and bindings. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public.ts"
  },
  "scripts": {
    "build": "",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "format": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json .",
    "format:check": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json --check ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@rivus/agent-kit-catalog": "workspace:*",
    "@rivus/agent-kit-platform": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.1",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.3.2",
    "@rivus/agent-kit-platform-node": "workspace:*",
    "@types/node": "24.19.1",
    "effect": "4.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": "4.0.1"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
