{
  "extends": ["./node_modules/@perfectpan/lint-config/oxlint.json"],
  "rules": {
    // @effect/vitest's it.effect and it.live are test blocks that the rule does not know by default.
    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["it.effect", "it.effect.each", "it.live"] }
    ]
  },
  "overrides": [
    {
      // These files parse external data with zod, whose `catch` helper the type-aware rule mistakes for
      // `Promise.prototype.catch`; the rest of the package keeps the rule.
      "files": [
        "src/application/use-cases/doctor.ts",
        "src/domain/lifecycle/adapters/payload-shape.ts",
        "src/infra/models/ledger-file.ts"
      ],
      "rules": { "promise/valid-params": "off" }
    }
  ]
}
