{
  "name": "@rivus/agent-kit-testing",
  "version": "0.0.0",
  "private": true,
  "description": "In-memory Platform and conformance tests for each context. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public.ts"
  },
  "scripts": {
    "build": "",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run --passWithNoTests 2>&1",
    "format": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json . '!test/fixtures/**'",
    "format:check": "oxfmt -c node_modules/@perfectpan/lint-config/oxfmt.json --check . '!test/fixtures/**'"
  },
  "dependencies": {
    "@rivus/agent-kit-catalog": "workspace:*",
    "@rivus/agent-kit-discovery": "workspace:*",
    "@rivus/agent-kit-harness": "workspace:*",
    "@rivus/agent-kit-platform": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.4.0",
    "@rivus/agent-kit-cost": "workspace:*",
    "@types/node": "24.19.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
