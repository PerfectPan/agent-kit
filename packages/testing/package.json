{
  "name": "@rivus/agent-kit-testing",
  "version": "0.0.0",
  "private": true,
  "description": "In-memory Platform and conformance tests for each context. Bundled into @rivus/agent-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./public": "./src/public.ts",
    "./public/effect": "./src/effect.ts"
  },
  "scripts": {
    "build": "",
    "lint": "vp lint 2>&1",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vp test --passWithNoTests 2>&1",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@rivus/agent-kit-catalog": "workspace:*",
    "@rivus/agent-kit-discovery": "workspace:*",
    "@rivus/agent-kit-harness": "workspace:*",
    "@rivus/agent-kit-platform": "workspace:*",
    "@rivus/agent-kit-sessions": "workspace:*",
    "es-toolkit": "catalog:"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit-cost": "workspace:*",
    "@rivus/agent-kit-provider-cursor": "workspace:*",
    "@rivus/agent-kit-provider-gemini-cli": "workspace:*",
    "@rivus/agent-kit-provider-opencode": "workspace:*",
    "@rivus/agent-kit-provider-pi": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "@rivus/agent-kit-provider-grok": "workspace:*",
    "@rivus/agent-kit-provider-claude-code": "workspace:*",
    "@rivus/agent-kit-provider-codex": "workspace:*"
  }
}
